<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GamingControlCenter.Dialogs.GraphicsTipsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:GamingControlCenter.Dialogs" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="GraphicsTipsDialog" Width="350" Height="100" AllowsTransparency="True" Background="#00FFFFFF" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" WindowStyle="None">
  <Grid>
    <Border Background="#E5444444" CornerRadius="8,8,8,8" />
    <Grid Name="BaseGrid" Margin="4" Background="#E5444444">
      <TextBlock Margin="10,20" FontFamily="/Fonts/#优设标题黑" FontSize="15" Foreground="#DCE0E4" Text="重启计算机后，更改将会生效" />
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
        <Border CornerRadius="38">
          <FrameworkElement.Style>
            <Style>
              <Style.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True" />
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <Button Margin="10,0" Background="#00FFFFFF" Content="确定" Cursor="Hand" FontFamily="/Fonts/#优设标题黑" FontSize="15" Foreground="#FFFFFFFF" Click="SureButton_OnClick" />
        </Border>
        <Border CornerRadius="38">
          <FrameworkElement.Style>
            <Style>
              <Style.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True" />
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <Button Margin="10,0" Background="#00FFFFFF" Content="取消" Cursor="Hand" FontFamily="/Fonts/#优设标题黑" FontSize="15" Foreground="#FFFFFFFF" Click="CancelButton_OnClick" />
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</Window>