<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GamingControlCenter.UserControl1" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:GamingControlCenter" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <DrawingBrush x:Key="MyGridBrushResource" TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
          <DrawingGroup>
            <DrawingGroup.Children>
              <GeometryDrawing Brush="#AF3E4660" Geometry="M0,0 L1,0 L1,0.01 L0,0.01" />
              <GeometryDrawing Brush="#AF3E4660" Geometry="M0,0 L0,1 L0.01,1 L0.01,0" />
            </DrawingGroup.Children>
          </DrawingGroup>
        </DrawingBrush.Drawing>
      </DrawingBrush>
      <Style x:Key="MyGridBorderStyle">
        <Setter Property="Border.Background" Value="{StaticResource MyGridBrushResource}" />
        <Setter Property="Border.BorderBrush" Value="#7F8B9E96" />
        <Setter Property="Border.BorderThickness" Value="1" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="20" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid Name="yGrid" />
    <Grid Name="_myGrid" Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="20" />
      </Grid.RowDefinitions>
      <Border RenderTransformOrigin="0.5,0.5" Style="{StaticResource MyGridBorderStyle}">
        <UIElement.RenderTransform>
          <TransformGroup>
            <ScaleTransform ScaleY="-1" />
            <SkewTransform />
            <RotateTransform />
            <TranslateTransform />
          </TransformGroup>
        </UIElement.RenderTransform>
        <Canvas Name="_myCanvas">
          <Polyline Name="_myPolyline" Stroke="#FFF0FFFF" StrokeThickness="2" />
          <Polyline Name="_myPolyline2" Stroke="#FFF0FFFF" StrokeThickness="1" />
        </Canvas>
      </Border>
      <Canvas Name="xLableCanvas" Grid.Row="1">
        <Grid Name="xGrid" />
      </Canvas>
    </Grid>
  </Grid>
</UserControl>