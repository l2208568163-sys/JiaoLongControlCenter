  <Style x:Key="ToggleButtonStyle1" TargetType="{x:Type ToggleButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Viewbox>
            <Border Name="Border" Width="40" Height="20" Background="#FF444B53" CornerRadius="10">
              <UIElement.Effect>
                <DropShadowEffect Direction="0" Opacity="0.3" ShadowDepth="0.5" />
              </UIElement.Effect>
              <Ellipse Name="Ellipse" Margin="2,1,2,1" HorizontalAlignment="Stretch" Fill="#FFFFFFFF" Stretch="Uniform" Stroke="#FF808080" StrokeThickness="0.2">
                <UIElement.Effect>
                  <DropShadowEffect BlurRadius="10" Direction="260" Opacity="0.3" ShadowDepth="1" />
                </UIElement.Effect>
              </Ellipse>
            </Border>
          </Viewbox>
          <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="ToggleButton.Checked">
              <BeginStoryboard>
                <Storyboard>
                  <ColorAnimation Storyboard.TargetName="Border" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#FF61F2FF" Duration="0:0:0.1" />
                  <ThicknessAnimation Storyboard.TargetName="Ellipse" Storyboard.TargetProperty="Margin" To="20 1 2 1" Duration="0:0:0.1" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="ToggleButton.Unchecked">
              <BeginStoryboard>
                <Storyboard>
                  <ColorAnimation Storyboard.TargetName="Border" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#FF444B53" Duration="0:0:0.1" />
                  <ThicknessAnimation Storyboard.TargetName="Ellipse" Storyboard.TargetProperty="Margin" To="2 1 2 1" Duration="0:0:0.1" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="#FFFF0000" />
      </Trigger>
    </Style.Triggers>
